# Copy this file to .env.local (same folder) and fill in the real values.
# .env.local is never committed. Get the values from Supabase:
# Project Settings > API (or Settings > API Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (sb_publishable_...) or, on older projects, the "anon" public key.
# Never put the service_role or secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
